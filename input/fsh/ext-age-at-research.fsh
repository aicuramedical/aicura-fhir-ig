Extension: AicuraAgeAtResearch
Id: AgeAtResearch
Title: "Age at Research"
Description: "Patient age in whole years at the start of the study participation, recorded instead of the date itself."
* ^url = "http://aicuramedical.com/fhir/StructureDefinition/AgeAtResearch"
* insert ExtensionContext(ResearchSubject)
* value[x] only integer
