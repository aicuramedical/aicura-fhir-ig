Extension: AicuraAgeOnset
Id: AgeOnset
Title: "Age at Onset"
Description: "Patient age in whole years at the condition's onset date, recorded instead of the date itself."
* ^url = "http://aicuramedical.com/fhir/StructureDefinition/AgeOnset"
* insert ExtensionContext(Condition)
* value[x] only integer
