Extension: AicuraAgeRecorded
Id: AgeRecorded
Title: "Age Recorded"
Description: "Patient age in whole years at the condition's recorded date, recorded instead of the date itself."
* ^url = "http://aicuramedical.com/fhir/StructureDefinition/AgeRecorded"
* insert ExtensionContext(Condition)
* value[x] only integer
