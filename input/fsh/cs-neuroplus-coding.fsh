CodeSystem: NeuroPlusCodingCS
Id: neuroplus-coding
Title: "Neuro+ CodeSystem"
Description: "Concepts specific to Neuro+, for which no standard terminology has a code. This IG lists only the concepts it uses (content = fragment)."
* ^url = $NeuroPlusCoding
* ^version = "1.0"
* ^status = #active
* ^caseSensitive = true
* ^experimental = false
* ^content = #fragment
// MRI sequences
* #MPRAGE "Magnetization-Prepared Rapid Gradient Echo"
* #IR-SPGR "Inversion Recovery Spoiled Gradient Echo"
* #IR-FSPGR "Inversion Recovery Fast Spoiled Gradient Echo"
* #"Accelerated IR-SPGR" "Accelerated Inversion Recovery Spoiled Gradient Echo"
* #"Accelerated IR-FSPGR" "Accelerated Inversion Recovery Fast Spoiled Gradient Echo"
* #TFE "Turbo Field Echo"
* #TSE "Turbo Spin Echo"
* #FSE "Fast Spin Echo"
* #GRE "Gradient Recalled Echo"
* #MEGRE "Multi-Echo Gradient Recalled Echo"
* #SWI "Susceptibility-Weighted Imaging"
* #MP2RAGE "Magnetization-Prepared 2 Rapid Acquisition Gradient Echoes"
* #"Unresolved Sequence Label" "Unresolved Sequence Label"
// MRI contrasts
* #T1w "T1w"
* #"T2w FLAIR" "T2w FLAIR"
* #"T1w FLAIR" "T1w FLAIR"
* #PDw "Proton Density"
* #T2w "T2w"
* #"PDw/T2w" "PDw/T2w (dual echo)"
* #"T2*w" "T2*w (gradient echo)"
* #DWI "Diffusion Weighted Imaging"
// Imaging dimension
* #3D "3-Dimensional"
* #2D "2-Dimensional"
// PET tracers
* #"Unresolved Tracer Label" "Unresolved Tracer Label"
// Brain regions with a Neuro+ code (BodyStructure.location)
* #"Anterior cingulate cortex" "Anterior cingulate cortex"
* #"Posterior cingulate cortex" "Posterior cingulate cortex"
* #"Isthmus of cingulate gyrus" "Isthmus of cingulate gyrus"
* #"Orbitofrontal cortex" "Orbitofrontal cortex"
* #"Pericalcarine cortex" "Pericalcarine cortex"
* #"Banks of superior temporal sulcus" "Banks of superior temporal sulcus"
* #"Hemisphere white matter" "Hemisphere white matter"
* #"Total brain gray matter" "Total brain gray matter"
* #"Subcortical gray matter" "Subcortical gray matter"
* #"White matter hypointensities" "White matter hypointensities"
* #"Non-white matter hypointensities" "Non-white matter hypointensities"
* #"Cerebral vasculature" "Cerebral vasculature"
* #"Intracranial volume [ICV]" "Intracranial volume [ICV]"
// Location qualifiers SNOMED CT has no fitting concept for (BodyStructure.locationQualifier)
* #"Ventral" "Ventral"
* #"Mid-Anterior" "Mid-Anterior"
* #"Mid-Posterior" "Mid-Posterior"
