ValueSet: AicuraMRISequenceVS
Id: aicura-mri-sequence
Title: "AICURA MRI Sequence ValueSet"
Description: "MRI pulse sequence types used in AICURA imaging studies."
* ^experimental = false
* $AicuraCoding#MPRAGE "Magnetization-Prepared Rapid Gradient Echo"
* $AicuraCoding#IR-SPGR "Inversion Recovery Spoiled Gradient Echo"
* $AicuraCoding#IR-FSPGR "Inversion Recovery Fast Spoiled Gradient Echo"
* $AicuraCoding#"Accelerated IR-SPGR" "Accelerated Inversion Recovery Spoiled Gradient Echo"
* $AicuraCoding#"Accelerated IR-FSPGR" "Accelerated Inversion Recovery Fast Spoiled Gradient Echo"
* $AicuraCoding#TFE "Turbo Field Echo"
* $AicuraCoding#TSE "Turbo Spin Echo"
* $AicuraCoding#FSE "Fast Spin Echo"
* $AicuraCoding#GRE "Gradient Recalled Echo"
* $AicuraCoding#MEGRE "Multi-Echo Gradient Recalled Echo"
* $AicuraCoding#SWI "Susceptibility-Weighted Imaging"
* $AicuraCoding#MP2RAGE "Magnetization-Prepared 2 Rapid Acquisition Gradient Echoes"
* $AicuraCoding#"Unresolved Sequence Label" "Unresolved Sequence Label"
