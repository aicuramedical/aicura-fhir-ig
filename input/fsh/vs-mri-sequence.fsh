ValueSet: NeuroPlusMRISequenceVS
Id: neuroplus-mri-sequence
Title: "Neuro+ MRI Sequence ValueSet"
Description: "MRI pulse sequence types used in Neuro+ imaging studies."
* ^experimental = false
* $NeuroPlusCoding#MPRAGE "Magnetization-Prepared Rapid Gradient Echo"
* $NeuroPlusCoding#IR-SPGR "Inversion Recovery Spoiled Gradient Echo"
* $NeuroPlusCoding#IR-FSPGR "Inversion Recovery Fast Spoiled Gradient Echo"
* $NeuroPlusCoding#"Accelerated IR-SPGR" "Accelerated Inversion Recovery Spoiled Gradient Echo"
* $NeuroPlusCoding#"Accelerated IR-FSPGR" "Accelerated Inversion Recovery Fast Spoiled Gradient Echo"
* $NeuroPlusCoding#TFE "Turbo Field Echo"
* $NeuroPlusCoding#TSE "Turbo Spin Echo"
* $NeuroPlusCoding#FSE "Fast Spin Echo"
* $NeuroPlusCoding#GRE "Gradient Recalled Echo"
* $NeuroPlusCoding#MEGRE "Multi-Echo Gradient Recalled Echo"
* $NeuroPlusCoding#SWI "Susceptibility-Weighted Imaging"
* $NeuroPlusCoding#MP2RAGE "Magnetization-Prepared 2 Rapid Acquisition Gradient Echoes"
* $NeuroPlusCoding#"Unresolved Sequence Label" "Unresolved Sequence Label"
